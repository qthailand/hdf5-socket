/*
 * Application stylesheet. Colours and fonts are tokens (@name) from the theme JSON
 * (themes/dark.json, themes/light.json); edit those to recolour, edit this file to restyle.
 * Widgets are addressed by objectName (#name) and the dynamic property [state="..."];
 * Python code sets only names/properties, never colours.
 */

/* ---------------------------------------------------------------- base --- */

QWidget {
    background-color: @bg;
    color: @text;
    font-family: "@font_family";
    font-size: 12px;
    selection-background-color: @selection;
}

QToolTip {
    background-color: @surface_alt;
    color: @text;
    border: 1px solid @border_strong;
    padding: 4px 6px;
}

QPushButton {
    background-color: @surface_alt;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 4px 10px;
}
QPushButton:hover { background-color: @surface_hover; border-color: @border_strong; }
QPushButton:pressed { background-color: @border; }

QComboBox {
    background-color: @surface_alt;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 3px 8px;
}
QSpinBox {
    background-color: @surface_alt;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 3px 6px;
    min-width: 120px;
}
QSpinBox:focus { border-color: @accent; }

QPushButton#presetButton { padding: 2px 8px; font-size: 11px; border-radius: 5px; }

QComboBox QAbstractItemView {
    background-color: @surface;
    color: @text;
    border: 1px solid @border_strong;
    selection-background-color: @selection;
}

QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; border: none; }

QScrollBar:vertical { background: @bg; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: @border_strong; border-radius: 5px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: @text_faint; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

/* ------------------------------------------------- panel + accent stripe --- */
/*
 * Reusable on any QFrame/QLabel (and subclasses), no object name needed:
 *     themes.make_panel(widget, accent='ok')      # surface + border + rounded corners + stripe
 *     themes.set_accent(widget, 'warn')           # change the stripe later (ok|warn|error|info|neutral)
 *     themes.set_accent_color(widget, (r, g, b))  # stripe in a data colour, e.g. a class colour
 * Accent rules come after the panel rule (same specificity), so the stripe wins on the left.
 * Rules for a named widget (#name) must not set its border/background, or the stripe is lost.
 */

QFrame[panel="true"] {
    background-color: @surface;
    border: 1px solid @border;
    border-radius: 6px;
}
QFrame[panel="alt"] {
    background-color: @surface_alt;
    border: 1px solid @border;
    border-radius: 8px;
}
QFrame[accent="ok"]      { border-left: 3px solid @success; }
QFrame[accent="warn"]    { border-left: 3px solid @warning; }
QFrame[accent="error"]   { border-left: 3px solid @danger; }
QFrame[accent="info"]    { border-left: 3px solid @accent; }
QFrame[accent="neutral"] { border-left: 3px solid @border_strong; }

/* ---------------------------------------------------------- main window --- */

QSplitter::handle { background-color: transparent; }
QSplitter::handle:vertical {
    margin: 3px 0;                 /* a thin line in the middle of the 8 px gap */
    border-radius: 1px;
    background-color: @border;
}
QSplitter::handle:vertical:hover { background-color: @accent; }
QSplitter::handle:vertical:pressed { background-color: @accent_hover; }
QSplitter::handle:horizontal {
    margin: 0 3px;                 /* a thin line in the middle of the 8 px gap */
    border-radius: 1px;
    background-color: @border;
}
QSplitter::handle:horizontal:hover { background-color: @accent; }
QSplitter::handle:horizontal:pressed { background-color: @accent_hover; }

QPushButton#toggleButton { padding: 3px 10px; color: @text_muted; }
QPushButton#toggleButton:checked {
    background-color: @surface_hover;
    color: @text;
    border-color: @accent;
}

QLabel#imagePanel {
    background-color: @image_bg;
    color: @text_faint;
    border: 1px solid @border;
    border-radius: 6px;
}

QLabel#statusLabel { padding: 6px 8px; font-size: 13px; font-weight: 600; color: @text; }
QLabel#statusLabel[accent="warn"]  { color: @warning; }
QLabel#statusLabel[accent="error"] { color: @danger; }

QLabel#operationState { padding: 6px 12px; font-size: 14px; font-weight: 600; }
QLabel#operationState[accent="error"] { color: @danger; }
QLabel#operationState[accent="warn"] { color: @warning; }
QLabel#operationContext { padding: 4px 8px; color: @text_muted; }
QTabWidget#workspaceTabs::pane { border: none; background: @bg; }
QTabWidget#workspaceTabs::tab-bar { left: 0; }

QLabel#backendLabel { padding: 4px 8px; font-size: 12px; color: @text_muted; }
QLabel#backendLabel[accent="warn"] { color: @warning; }

QLabel#infoLabel { padding: 6px 8px; font-family: "@mono_family"; font-size: 11px; color: @text_muted; }

/* ------------------------------------------------------- processing steps --- */

QCheckBox#stepCheck { background: transparent; color: @text; spacing: 6px; padding: 2px 4px; }
QCheckBox#stepCheck:disabled { color: @text_faint; }
QCheckBox#stepCheck::indicator {
    width: 13px; height: 13px;
    border: 1px solid @border_strong;
    border-radius: 3px;
    background: @surface_alt;
}
QCheckBox#stepCheck::indicator:hover { border-color: @accent; }
QCheckBox#stepCheck::indicator:checked { background: @accent; border-color: @accent; }
QCheckBox#stepCheck::indicator:disabled { background: @surface; border-color: @border; }
QCheckBox#stepCheck::indicator:checked:disabled { background: @text_faint; border-color: @text_faint; }

QLabel#stepWarning { background: transparent; color: @warning; font-weight: 600; padding-left: 10px; }

/* ------------------------------------------------------------ side tabs --- */

QTabWidget#sideTabs::pane { border: none; background: @bg; }
QTabWidget#sideTabs::tab-bar { left: 6px; }
QTabBar::tab {
    background: transparent;
    color: @text_faint;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 16px;           /* no font-size/-weight here: Qt sizes tabs before applying them */
}
QTabBar::tab:hover { color: @text; }
QTabBar::tab:selected { color: @text; border-bottom: 2px solid @accent; }

/* Performance panel: KPI values; chart colours are the chart_* tokens (used from Python). */
QLabel#kpiValue { background: transparent; color: @text; font-size: 15px; font-weight: 700; }

/* --------------------------------------------------------- class legend --- */

QLabel#panelTitle { font-size: 16px; font-weight: 700; color: @text; }

QPushButton#dangerButton {
    background-color: @danger;
    color: @on_accent;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    font-size: 11px;
    padding: 4px 10px;
}
QPushButton#dangerButton:hover { background-color: @danger_hover; }

QLabel#caption { background: transparent; color: @text_faint; font-size: 10px; font-weight: 700; }
QLabel#bigValue { background: transparent; color: @text; font-size: 20px; font-weight: 700; }

/* Materials: class key (badge, name, accumulated pixels); bar colours are class colours. */
QLabel#className { background: transparent; font-size: 13px; font-weight: 700; color: @text; }
QLabel#metricCaption { background: transparent; font-size: 11px; color: @text_faint; }
QLabel#metricRealtime { background: transparent; font-size: 13px; font-weight: 700; color: @accent_hover; }
QLabel#metricTotal { background: transparent; font-size: 13px; font-weight: 700; color: @success; }
QLabel#className:disabled, QLabel#metricTotal:disabled { color: @text_faint; }   /* hidden class */

/* Composition tab: accumulated share per class; swatch colour is the class colour (set in code). */
QLabel#shareValue { background: transparent; font-size: 15px; font-weight: 700; color: @text; }
QLabel#classSwatch { border: 1px solid @border_strong; border-radius: 3px; }
/* Accumulated / Real-time switch above the pie chart. */
QPushButton#segmentButton { padding: 2px 8px; font-size: 11px; border-radius: 5px; color: @text_muted; }
QPushButton#segmentButton:checked { background-color: @surface_hover; color: @text; border-color: @accent; }

/* Badge colour is the class colour, set per widget by the legend. */
QPushButton#classBadge { border: 1px solid @border_strong; border-radius: 4px; padding: 0; }
QPushButton#classBadge:hover { border: 2px solid @accent_hover; }

/* Materials: model selector, one tile per model of the models folder (widgets/model_selector.py). */
QPushButton#modelTile {
    background-color: @surface_alt;
    border: 1px solid @border_strong;
    border-radius: 8px;
    padding: 0;
    text-align: left;
}
QPushButton#modelTile:hover { background-color: @surface_hover; border-color: @accent_hover; }
QPushButton#modelTile:checked { background-color: @surface_hover; border: 2px solid @accent; }
QPushButton#modelTile:disabled { background-color: @surface; border-color: @border; }
/* a model trained in this session (quick model): not a file, gone when the program closes */
QPushButton#modelTile[session="true"] { border-style: dashed; }
QPushButton#modelTile[session="true"]:checked { border: 2px dashed @accent; }
QLabel#modelTileName { background: transparent; font-size: 13px; font-weight: 700; color: @text; }
QLabel#modelTileKind { background: transparent; font-size: 11px; color: @text_muted; }
QLabel#modelTileKind[resampled="true"] { color: @warning; }
QLabel#modelTileName:disabled, QLabel#modelTileKind:disabled { color: @text_faint; }

/* ------------------------------------------------ calibration dialogs --- */

QDoubleSpinBox {
    background-color: @surface_alt;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 3px 6px;
}
QDoubleSpinBox:focus, QComboBox:focus { border-color: @accent; }

QPushButton#primaryButton {
    background-color: @accent;
    color: @on_accent;
    border-color: @accent;
    font-weight: 600;
    padding: 6px 18px;
}
QPushButton#primaryButton:hover { background-color: @accent_hover; border-color: @accent_hover; }
QPushButton#primaryButton:disabled { background-color: @surface_alt; color: @text_faint; border-color: @border; }
QPushButton#quietButton { padding: 6px 14px; }
QPushButton#quietButton:disabled { color: @text_faint; }

QGraphicsView#referenceView { background-color: @image_bg; border: 1px solid @border; border-radius: 6px; }

QLabel#dialogTitle { background: transparent; font-size: 17px; font-weight: 700; color: @text; }
QLabel#fieldLabel { background: transparent; color: @text_muted; font-size: 11px; }
QLabel#rowName { background: transparent; color: @text; font-size: 12px; font-weight: 600; }
QLabel#rowSource { background: transparent; color: @text_muted; font-size: 11px; }
QLabel#issueList { background: transparent; color: @text_muted; font-size: 11px; }

/* state pill: ON / OFF / IN FACTORS ... */
QLabel#chip {
    background-color: @surface_hover;
    color: @text_muted;
    border: 1px solid @border_strong;
    border-radius: 9px;
    padding: 0;
    font-size: 10px;
    font-weight: 700;
}
QLabel#chip[state="ok"]    { color: @success; border-color: @success; }
QLabel#chip[state="warn"]  { color: @warning; border-color: @warning; }
QLabel#chip[state="error"] { color: @danger;  border-color: @danger; }

QLabel#verdict { background: transparent; font-size: 16px; font-weight: 700; color: @text_muted; }
QLabel#verdict[state="ok"]    { color: @success; }
QLabel#verdict[state="warn"]  { color: @warning; }
QLabel#verdict[state="error"] { color: @danger; }

/* --------------------------------------------- pipeline view (Setup tab) --- */
/* Full border in the state's colour (no stripe): a problem is seen from across the room.
 * Every box keeps a 2 px border, so selecting one only changes colours, never the layout. */
QFrame#pipelineBlock, QFrame#pipelineDetail {
    background-color: @surface;
    border: 2px solid @border;
    border-radius: 8px;
}
QFrame#pipelineBlock[state="ok"],    QFrame#pipelineDetail[state="ok"]    { border-color: @success; }
QFrame#pipelineBlock[state="warn"],  QFrame#pipelineDetail[state="warn"]  { border-color: @warning; }
QFrame#pipelineBlock[state="error"], QFrame#pipelineDetail[state="error"] { border-color: @danger; }
QFrame#pipelineBlock[state="off"] { background-color: @bg; border-color: @border; }
QFrame#pipelineBlock[selected="true"] { background-color: @surface_hover; }
QFrame#pipelineBlock[selected="true"][state="off"] { border-color: @text_faint; }
QFrame#setupPanel {
    background-color: @surface;
    border: 1px solid @border;
    border-radius: 8px;
}
QLabel#detailTitle { background: transparent; color: @text; font-size: 14px; font-weight: 700; }
QLabel#detailState { background: transparent; color: @text_muted; font-size: 12px; font-weight: 600; }
QLabel#detailState[state="ok"]    { color: @success; }
QLabel#detailState[state="warn"]  { color: @warning; }
QLabel#detailState[state="error"] { color: @danger; }
QLabel#blockTitle { background: transparent; color: @text; font-size: 12px; font-weight: 600; }
QLabel#blockLine  { background: transparent; color: @text_muted; font-size: 11px; }
QLabel#blockTime  { background: transparent; color: @text_faint; font-size: 10px; }
QLabel#blockArrow { background: transparent; color: @text_faint; font-size: 16px; }
QLabel#blockDot   { background: transparent; color: @text_faint; font-size: 11px; }
QLabel#blockDot[state="ok"]    { color: @success; }
QLabel#blockDot[state="warn"]  { color: @warning; }
QLabel#blockDot[state="error"] { color: @danger; }
QLabel#pipelineSummary { background: transparent; color: @text_muted; font-size: 12px; font-weight: 600; }
QLabel#pipelineSummary[state="ok"]    { color: @success; }
QLabel#pipelineSummary[state="warn"]  { color: @warning; }
QLabel#pipelineSummary[state="error"] { color: @danger; }
QLabel#pipelineNote { background: transparent; color: @text_muted; font-size: 12px; }
QLabel#pipelineNote[state="warn"]  { color: @warning; }
QLabel#pipelineNote[state="error"] { color: @danger; }
QLabel#pipelineStatusItem { background: transparent; color: @text_muted; font-size: 12px; }
QLabel#pipelineStatusItem[state="warn"]  { color: @warning; }
QLabel#pipelineStatusItem[state="error"] { color: @danger; }
QLabel#workspaceTitle { background: transparent; color: @text_muted; font-size: 11px; font-weight: 600; }
QLabel#fileRow  { background: transparent; color: @text; font-size: 12px; }
QLabel#fileAge  { background: transparent; color: @text_faint; font-size: 11px; }
QLabel#fileRow[state="warn"] { color: @warning; }
QFrame#nextSteps { background-color: @surface; border: 1px solid @border; border-radius: 8px; }
QFrame#nextSteps[state="warn"]  { border-color: @warning; }
QFrame#nextSteps[state="error"] { border-color: @danger; }
QLabel#stepNumber { background: transparent; color: @text_faint; font-size: 12px; font-weight: 700; }
QLabel#stepNumber[state="warn"]  { color: @warning; }
QLabel#stepNumber[state="error"] { color: @danger; }
QLabel#stepText { background: transparent; color: @text; font-size: 12px; }
QPushButton#advancedToggle { text-align: left; padding: 4px 8px; color: @text_muted; border: none; background: transparent; }
QPushButton#advancedToggle:hover { color: @text; }
QLabel#temperatureValue { background: transparent; color: @text; font-size: 20px; font-weight: 700; }
QLabel#temperatureValue[state="ok"]   { color: @success; }
QLabel#temperatureValue[state="warn"] { color: @warning; }
QStackedWidget#setupStack, QStackedWidget#setupStack > QWidget { background: transparent; border: none; }
/* focus aid on the Setup tab: a full border in its level colour, like the step boxes */
QFrame#focusPanel { border: 2px solid @border; border-radius: 8px; }
QFrame#focusPanel[accent="ok"]   { border: 2px solid @success; }
QFrame#focusPanel[accent="info"] { border: 2px solid @chart_2; }
QFrame#focusPanel[accent="warn"] { border: 2px solid @warning; }
